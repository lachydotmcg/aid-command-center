# Copy to .env and fill in. Loaded by the server and Discord bot launchers.

# Discord bot token — only needed if you run the optional Discord bot.
DISCORD_TOKEN=your_discord_bot_token_here

# Optional Codex runner overrides used by server.js.
# For trusted local automation that should behave like Claude's skip-permissions mode:
# ACC_CODEX_SANDBOX=danger-full-access
#
# Safer default: keep ACC_CODEX_SANDBOX=workspace-write, allow broad reads, and
# add semicolon-separated extra writable folders.
# ACC_CODEX_DISK_FULL_READ=true
# ACC_CODEX_ADD_DIRS=C:\Users\you\Documents\agent-memory

# Netlify form submission notifications → Discord.
# Set NETLIFY_DISCORD_WEBHOOK to a Discord channel webhook URL (channel settings →
# Integrations → Webhooks). Netlify should be configured to POST to:
#   https://your-tunnel.trycloudflare.com/netlify-webhook
# Optionally set a shared secret and add it as a custom header in Netlify (key:
# X-Webhook-Secret) so the server can verify the request origin.
# NETLIFY_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# NETLIFY_WEBHOOK_SECRET=some-long-random-string
